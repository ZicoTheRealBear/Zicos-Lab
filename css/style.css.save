body {
    font-family: Arial, sans-serif;
    margin: 40px;
    background-color: #1e1e1e;
    color: white;
}

nav a {
    color: #4fc3f7;
    text-decoration: none; 

}

nav a {
  
}

nav {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	
}

nav a:hover {
    color: Purple;
}

header {
	display: flex;
 	flex-direction: row;
	justify-content: space-between;   
}


.intro {
	font-size: 22px;
	line-height: 1.5x;
}

Footer {
	font-size: 11px;
	color: Grey;
	margin-top: 30px;

}

.projects {
	 margin: 20px;
}

.cards {

	display: flex;
	gap: 80px;
	flex-direction: row;
	justify-content: center;

}

.card {
	
	border: 3px solid white;
	padding: 20px;

}

